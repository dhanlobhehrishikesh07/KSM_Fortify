# OPTIONAL. The app now keeps keys and settings in the SETTINGS tab (stored outside this folder,
# so upgrades never lose them). You only need this file if you prefer .env files:
# the app reads it as a fallback, and the SETTINGS tab can import it with one click.
# Copy this file to ".env" and fill in your own values. .env is git-ignored.

# --- Identity -----------------------------------------------------
ASSISTANT_NAME=Karauli Shankar Mahadev
USER_NAME=Hrishikesh
# Short phrase the AI uses to describe you (goes into the prompts)
USER_PROFILE=a student at IIIT Raichur

# --- AI providers ---------------------------------------------------
# Get a Groq key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL_ID=openai/gpt-oss-120b

# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL_ID=gemini-3.5-flash-lite

# --- Mobile sync (optional) ------------------------------------------
# Set to true only if you have a Firebase Realtime Database project and
# have placed serviceAccountKey.json in the project root.
ENABLE_FIREBASE=false
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
FIREBASE_DATABASE_URL=

# --- Data file name (lives in ./data/) -------------------------------
DATA_FILE_NAME=matrix_data_pro.json

# --- Screen Scan (vision) ------------------------------------------------
# Uses GEMINI_API_KEY above. Fast free-tier vision model:
SCREEN_MODEL_ID=gemini-2.5-flash-lite
SCREEN_MAX_WIDTH=1920
SCREEN_JPEG_QUALITY=85
SCREEN_HIDE_DELAY=0.8

# --- Debugging -----------------------------------------------------------
LOG_LEVEL=DEBUG
# true = open the browser dev-tools inside the app window
DEBUG_UI=false
